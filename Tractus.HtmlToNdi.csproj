<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <OutputType>Exe</OutputType>
	  <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <ApplicationManifest>app.manifest</ApplicationManifest>
	  <Version>2024.12.3.1</Version>
	  <ApplicationIcon>HtmlToNdi.ico</ApplicationIcon>
	  <PlatformTarget>x64</PlatformTarget>
	  <Platforms>AnyCPU;x64</Platforms>
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
	  <!--
	    Server GC is enabled because this is a real-time video pipeline that
	    cannot tolerate the multi-tens-of-millisecond Gen2 pause spikes that
	    Workstation GC produces under steady-state load. We measured an ~8x
	    reduction in output-jitter RMS at 30p with Server GC vs the default,
	    with no observed downsides on the desktop hosts this app targets.
	    Concurrent collection is left on so most collection work overlaps
	    application threads instead of stop-the-world. Note: the runtime
	    GC latency mode override flag applies within this baseline, and
	    LowLatency mode specifically is incompatible with Server GC and is
	    logged-and-skipped by ApplySystemTuning rather than crashing startup.
	  -->
	  <ServerGarbageCollection>true</ServerGarbageCollection>
	  <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
	  <Company>Tractus Events</Company>
          <UseWindowsForms>true</UseWindowsForms>
          <EnableWindowsTargeting>true</EnableWindowsTargeting>

  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="publish_htmlndi\**" />
    <EmbeddedResource Remove="publish_htmlndi\**" />
    <None Remove="publish_htmlndi\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="Tests\**\*" />
    <Content Remove="Tests\**\*" />
    <EmbeddedResource Remove="Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Evaluations\**\*.cs" />
    <None Remove="Evaluations\**\*" />
    <Content Remove="Evaluations\**\*" />
    <EmbeddedResource Remove="Evaluations\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
    <None Remove="Tools\**\*" />
    <Content Remove="Tools\**\*" />
    <EmbeddedResource Remove="Tools\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="HtmlToNdi.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="Native\Processing.NDI.Lib.x64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>runtimes/win-x64/native/Processing.NDI.Lib.x64.dll</TargetPath>
    </None>
  </ItemGroup>
        <ItemGroup>
                <FrameworkReference Include="Microsoft.AspNetCore.App" />
        </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="CefSharp.OffScreen.NETCore" Version="146.0.100" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.8" />
    <PackageReference Include="Semi.Avalonia" Version="11.2.1.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
	  <PackageReference Include="NDILibDotNetCoreBase" Version="2024.7.22.1" />
	  <PackageReference Include="Serilog" Version="4.0.1" />
	  <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
	  <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
	  <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="HtmlToNdi.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
